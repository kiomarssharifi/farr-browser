{
  "name": "farr-browser",
  "version": "0.1.0",
  "description": "A polite browser for AI agents: live sessions with refs, stale-ref and irreversible-action refusals, markdown reading, robots.txt and pacing, bring-your-own proxies, site skills, and an MCP server.",
  "license": "Apache-2.0",
  "author": "Kiomars Sharifi",
  "keywords": [
    "browser",
    "ai-agents",
    "mcp",
    "playwright",
    "robots-txt",
    "markdown",
    "automation"
  ],
  "type": "commonjs",
  "main": "lib/index.js",
  "bin": {
    "farr-browser": "bin/farr-browser",
    "farr-browser-mcp": "bin/farr-browser-mcp"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "CITATION.cff"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.63.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiomarssharifi/farr-browser.git"
  },
  "homepage": "https://github.com/kiomarssharifi/farr-browser",
  "bugs": {
    "url": "https://github.com/kiomarssharifi/farr-browser/issues"
  }
}
